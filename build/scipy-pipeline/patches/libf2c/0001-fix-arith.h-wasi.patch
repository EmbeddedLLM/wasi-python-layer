From 01990867ee7a641078505efba367a413a97f7802 Mon Sep 17 00:00:00 2001
From: adapted for WASI (original: Michael Droettboom)
Date: 2026-08-10
Subject: [PATCH] fix arith.h generation for wasm32-wasip1 under Node WASI

arith.h is generated by compiling and RUNNING arithchk.c. The emscripten
recipe runs the wasm via `node a.out.js`. For WASI there is no JS glue: the
helper is compiled as a wasm32-wasip1 module (Node's WASI is preview1) and
executed with `node run-wasi-preview1.js` (see make.inc.wasi ARITH_* vars,
set by 01-libf2c.sh). The wasip1 helper is codegen-only, never shipped; the
main libf2c.a build stays wasm32-wasip2.

---
 F2CLIBS/libf2c/Makefile | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/F2CLIBS/libf2c/Makefile b/F2CLIBS/libf2c/Makefile
index 0a3ed0d..8a1f5c7 100644
--- a/F2CLIBS/libf2c/Makefile
+++ b/F2CLIBS/libf2c/Makefile
@@ -173,8 +173,8 @@ xwsne.o:	fmt.h
 arith.h: arithchk.c
-	$(CC) $(CFLAGS) -DNO_FPINIT arithchk.c -lm ||\
-	 $(CC) -DNO_LONG_LONG $(CFLAGS) -DNO_FPINIT arithchk.c -lm
-	./a.out >arith.h
-	rm -f a.out arithchk.o
+	$(ARITH_CC) $(ARITH_CFLAGS) -DNO_FPINIT arithchk.c -lm -o arithchk.wasm ||\
+	 $(ARITH_CC) -DNO_LONG_LONG $(ARITH_CFLAGS) -DNO_FPINIT arithchk.c -lm -o arithchk.wasm
+	$(NODE) $(ARITH_RUNNER) arithchk.wasm >arith.h
+	rm -f arithchk.wasm arithchk.o
 
 check:
 	xsum Notice README abort_.c arithchk.c backspac.c c_abs.c c_cos.c \
-- 
