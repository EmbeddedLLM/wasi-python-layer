#!/bin/bash
# "cross-python": a host python3.14 that reports the WASM CPython's sysconfig.
#
# meson's python introspection (and the cython sanity check) need a python that reports
# the *target* (wasm32) sysconfig — wasm include dir, SIZEOF_VOID_P=4, wasm EXT_SUFFIX —
# while still running natively. Setting PYTHONHOME to the wasm CPython install makes
# sysconfig report the wasm paths/sizes; the host python binary still executes.
#
# Generated by 01-toolchain.sh from cross-python.sh.in (substitutes @WASI_BUILD@).
export PYTHONHOME="@WASI_BUILD@/cpython-wasi/install"
export _PYTHON_SYSCONFIGDATA_NAME=_sysconfigdata__wasi_wasm32-wasi
# PYTHONHOME hides the host python's own stdlib (no importable math/os/...),
# which breaks build-time helpers that run through this wrapper (OpenCV gen2.py,
# skimage tempita, pythran probes). Put the HOST stdlib + its lib-dynload on
# PYTHONPATH so pure-python tooling imports; sysconfig still reports wasm (the
# _PYTHON_SYSCONFIGDATA_NAME above). Do NOT add host site-packages here — the
# wasm numpy include must keep resolving from the wasm install.
# APPEND to any inherited PYTHONPATH (numpy's meson sets PYTHONPATH to
# $SRC/numpy/_core for the umath codegen; clobbering it breaks
# code_generators.generate_umath — regression d5c5d71, caught by the first
# cold CI build).
export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}@WASI_BUILD@/cpython-host/install/lib/python3.14:@WASI_BUILD@/cpython-host/install/lib/python3.14/lib-dynload"
exec "@WASI_BUILD@/cpython-host/install/bin/python3.14" "$@"
